---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/astro/docs/Sidebar.astro';
import TableOfContents from '../components/astro/docs/TableOfContents.astro';

interface Props {
  doc: CollectionEntry<'docs'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { doc, headings } = Astro.props;
const { title, description } = doc.data;

// Get all docs for sidebar
const allDocs = await getCollection('docs');
---

<BaseLayout title={`${title} | Skill Seekers Docs`} description={description}>
  <div class="flex min-h-screen bg-dark-bg">
    <!-- Sidebar -->
    <Sidebar docs={allDocs} currentSlug={doc.slug} />

    <!-- Main Content -->
    <main class="flex-1 px-4 py-8 sm:px-6 lg:px-8 xl:ml-64">
      <div class="mx-auto max-w-4xl">
        <!-- Breadcrumbs -->
        <nav class="mb-8 text-sm" aria-label="Breadcrumb">
          <ol class="flex items-center space-x-2 text-dark-text-secondary">
            <li><a href="/" class="hover:text-brand-primary transition-colors">Home</a></li>
            <li class="flex items-center">
              <svg class="h-4 w-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <a href="/docs/getting-started/overview" class="hover:text-brand-primary transition-colors">Docs</a>
            </li>
            <li class="flex items-center">
              <svg class="h-4 w-4 mx-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-dark-text-primary">{title}</span>
            </li>
          </ol>
        </nav>

        <!-- Article -->
        <article class="prose prose-invert prose-indigo max-w-none prose-lg">
          <h1 class="text-4xl font-bold mb-4 text-dark-text-primary">{title}</h1>
          <p class="text-lg text-dark-text-secondary mb-8 leading-relaxed">{description}</p>

          <div class="
            prose-headings:text-dark-text-primary prose-headings:font-semibold prose-headings:tracking-tight
            prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-3 prose-h2:border-b prose-h2:border-dark-border
            prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-4
            prose-h4:text-xl prose-h4:mt-6 prose-h4:mb-3
            prose-p:text-dark-text-secondary prose-p:leading-relaxed prose-p:mb-6
            prose-a:text-brand-primary prose-a:no-underline hover:prose-a:text-brand-secondary prose-a:transition-colors prose-a:font-medium
            prose-strong:text-dark-text-primary prose-strong:font-semibold
            prose-code:text-brand-secondary prose-code:bg-dark-surface prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-mono prose-code:before:content-[''] prose-code:after:content-['']
            prose-pre:bg-dark-surface prose-pre:border prose-pre:border-dark-border prose-pre:rounded-lg prose-pre:p-4 prose-pre:overflow-x-auto prose-pre:my-6
            prose-ul:my-6 prose-ul:space-y-3
            prose-ol:my-6 prose-ol:space-y-3
            prose-li:text-dark-text-secondary prose-li:leading-relaxed prose-li:pl-2
            prose-li:marker:text-brand-primary
            prose-blockquote:border-l-4 prose-blockquote:border-brand-primary prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:text-dark-text-secondary prose-blockquote:bg-dark-surface prose-blockquote:py-2 prose-blockquote:my-6 prose-blockquote:rounded-r
            prose-table:border-collapse prose-table:w-full prose-table:my-8
            prose-thead:border-b-2 prose-thead:border-dark-border
            prose-th:text-left prose-th:p-3 prose-th:text-dark-text-primary prose-th:font-semibold prose-th:bg-dark-surface
            prose-td:p-3 prose-td:text-dark-text-secondary prose-td:border-t prose-td:border-dark-border
            prose-tr:hover:bg-dark-surface/50 prose-tr:transition-colors
            prose-img:rounded-lg prose-img:border prose-img:border-dark-border prose-img:my-8
            prose-hr:border-dark-border prose-hr:my-8
          ">
            <slot />
          </div>
        </article>

        <!-- Page Navigation -->
        <div class="mt-12 pt-8 border-t border-dark-border flex justify-between">
          <div>
            <!-- Previous page link will go here -->
          </div>
          <div>
            <!-- Next page link will go here -->
          </div>
        </div>
      </div>
    </main>

    <!-- Table of Contents (desktop only) -->
    {headings.length > 0 && (
      <aside class="hidden xl:block xl:w-64 flex-shrink-0">
        <div class="sticky top-20 py-8">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    )}
  </div>
</BaseLayout>
