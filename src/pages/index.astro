---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/astro/landing/Hero.astro';
import About from '../components/astro/landing/About.astro';
import FeatureMatrix from '../components/react/FeatureMatrix';
import QuickStart from '../components/astro/landing/QuickStart.astro';
import UseCases from '../components/astro/landing/UseCases.astro';
import Stats from '../components/astro/landing/Stats.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

export const prerender = true;
---

<BaseLayout
  title="Skill Seekers - Transform Docs into Claude AI Skills"
  description="Automatically convert documentation websites, GitHub repositories, and PDFs into production-ready Claude AI skills in minutes. Supports Claude, Gemini, OpenAI, and more."
>
  <Hero />
  <About />
  <div id="feature-matrix">
    <FeatureMatrix client:load lang={lang} />
  </div>
  <QuickStart />
  <UseCases />
  <Stats />
</BaseLayout>
