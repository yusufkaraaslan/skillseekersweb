---
// Sources and Formats showcase section
import { getLangFromUrl, getTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

const isZh = lang === 'zh';

const inputSources = [
  { icon: '🌐', name: isZh ? '文档网站' : 'Documentation', desc: isZh ? '任何文档站点，Docusaurus、GitBook、ReadTheDocs' : 'Any doc site, Docusaurus, GitBook, ReadTheDocs' },
  { icon: '🐙', name: isZh ? 'GitHub 仓库' : 'GitHub Repos', desc: isZh ? '公共和私有仓库，带 AST 分析' : 'Public & private repos, with AST analysis' },
  { icon: '📄', name: isZh ? 'PDF 文件' : 'PDF Files', desc: isZh ? '扫描文档、手册、带有 OCR 的研究论文' : 'Scanned docs, manuals, research papers with OCR' },
  { icon: '💻', name: isZh ? '本地代码库' : 'Local Codebases', desc: isZh ? '27+ 语言，游戏引擎，自定义项目' : '27+ languages, game engines, custom projects' },
];

const outputFormats = [
  { category: isZh ? 'RAG / 向量' : 'RAG / Vectors', items: ['LangChain', 'LlamaIndex', 'Chroma', 'FAISS', 'Haystack', 'Qdrant', 'Weaviate'] },
  { category: isZh ? 'AI 平台' : 'AI Platforms', items: ['Claude', 'Gemini', 'OpenAI'] },
  { category: isZh ? 'AI 编码' : 'AI Coding', items: ['Cursor', 'Windsurf', 'Cline', 'Continue.dev'] },
  { category: isZh ? '通用' : 'Generic', items: ['Markdown', 'JSON', 'YAML'] },
];
---

<section class="py-20 bg-dark-bg">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center mb-16">
      <h2 class="text-4xl font-bold mb-6 text-white">
        {isZh ? '任何源 → 任何 AI 系统' : 'Any Source → Any AI System'}
      </h2>
      <p class="text-xl text-dark-text-secondary">
        {isZh 
          ? '一个工具统一您的所有数据预处理需求' 
          : 'One tool unifies all your data preprocessing needs'}
      </p>
    </div>

    <!-- Input Sources -->
    <div class="max-w-6xl mx-auto mb-20">
      <h3 class="text-2xl font-semibold mb-8 text-center text-white">
        {isZh ? '输入源' : 'Input Sources'}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {inputSources.map(source => (
          <div class="bg-dark-surface rounded-xl p-6 border border-dark-border hover:border-brand-primary transition-all duration-300 hover:shadow-lg hover:shadow-brand-primary/10 group">
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">{source.icon}</div>
            <h4 class="text-lg font-semibold mb-2 text-white">{source.name}</h4>
            <p class="text-sm text-dark-text-secondary">{source.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Arrow -->
    <div class="flex justify-center mb-12">
      <div class="w-16 h-16 rounded-full bg-gradient-to-r from-brand-primary to-brand-secondary flex items-center justify-center animate-pulse">
        <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </div>

    <!-- Output Formats -->
    <div class="max-w-6xl mx-auto">
      <h3 class="text-2xl font-semibold mb-8 text-center text-white">
        {isZh ? '16 种输出格式' : '16 Output Formats'}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {outputFormats.map(format => (
          <div class="bg-dark-surface rounded-xl p-6 border border-dark-border">
            <h4 class="text-lg font-semibold mb-4 text-brand-primary">{format.category}</h4>
            <div class="flex flex-wrap gap-2">
              {format.items.map(item => (
                <span class="px-3 py-1 bg-dark-bg rounded-full text-sm text-dark-text-primary border border-dark-border">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Code Example -->
    <div class="max-w-4xl mx-auto mt-16">
      <div class="bg-dark-surface rounded-xl border border-dark-border overflow-hidden">
        <div class="flex items-center justify-between px-4 py-3 bg-dark-bg border-b border-dark-border">
          <span class="text-sm text-dark-text-secondary">{isZh ? '示例：React → LangChain' : 'Example: React → LangChain'}</span>
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
          </div>
        </div>
        <div class="p-6 font-mono text-sm overflow-x-auto">
          <div class="text-dark-text-secondary"># {isZh ? '一步：抓取文档' : 'One command: scrape docs'}</div>
          <div class="text-white">$ <span class="text-brand-primary">skill-seekers</span> scrape --config react.json</div>
          <div class="text-dark-text-secondary mt-2"># {isZh ? '一步：打包为任意格式' : 'One command: package for any format'}</div>
          <div class="text-white">$ <span class="text-brand-primary">skill-seekers</span> package output/react --target langchain</div>
          <div class="text-dark-text-secondary mt-2"># {isZh ? '完成！准备用于您的 RAG 管道' : 'Done! Ready for your RAG pipeline'}</div>
        </div>
      </div>
    </div>
  </div>
</section>
