---
// Use cases section with examples
import { getLangFromUrl, getTranslations } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

const gradients = [
  '#3b82f6, #06b6d4',
  '#a855f7, #ec4899',
  '#22c55e, #10b981',
  '#f97316, #ef4444',
  '#6366f1, #a855f7',
];

const useCases = t.usecases.cases.map((useCase: any, index: number) => ({
  ...useCase,
  gradient: gradients[index],
}));
---

<section class="py-20 bg-dark-bg">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center mb-16">
      <h2 class="text-4xl font-bold mb-4">
        <span class="bg-gradient-to-r from-brand-primary to-brand-secondary bg-clip-text text-transparent">
          {t.usecases.title}
        </span>
      </h2>
      <p class="text-xl text-dark-text-secondary">
        {t.usecases.subtitle}
      </p>
    </div>

    <!-- Use Cases Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {useCases.map((useCase: any, index: number) => (
        <div
          class="group relative overflow-hidden rounded-xl border border-dark-border bg-dark-surface p-8 transition-all duration-300 hover:border-brand-primary hover:shadow-2xl hover:shadow-brand-primary/20 hover:-translate-y-1"
          style={`animation-delay: ${index * 100}ms`}
        >
          <!-- Icon with gradient background -->
          <div
            class="mb-6 flex h-16 w-16 items-center justify-center rounded-lg text-4xl shadow-lg transition-transform group-hover:scale-110 group-hover:rotate-3"
            style={`background: linear-gradient(135deg, ${useCase.gradient})`}
          >
            {useCase.icon}
          </div>

          <!-- Title -->
          <h3 class="mb-3 text-2xl font-semibold text-dark-text-primary group-hover:text-brand-primary transition-colors">
            {useCase.title}
          </h3>

          <!-- Description -->
          <p class="mb-4 text-dark-text-secondary leading-relaxed">
            {useCase.description}
          </p>

          <!-- Example -->
          <div class="rounded-lg bg-dark-bg/50 p-4 border border-dark-border/50 group-hover:border-brand-primary/30 transition-colors">
            <p class="text-sm text-dark-text-secondary italic leading-relaxed">
              "{useCase.example}"
            </p>
          </div>

          <!-- Animated glow effect -->
          <div class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-primary/5 to-brand-secondary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
      ))}
    </div>

    <!-- Platform Support Banner -->
    <div class="rounded-lg border border-dark-border bg-gradient-to-r from-dark-surface to-dark-bg p-8">
      <div class="text-center">
        <h3 class="text-2xl font-semibold mb-4">{t.usecases.platforms.title}</h3>
        <p class="text-dark-text-secondary mb-6">
          {t.usecases.platforms.subtitle}
        </p>

        <!-- Platform badges -->
        <div class="flex flex-wrap items-center justify-center gap-4">
          {t.usecases.platforms.items.map((platform: string) => (
            <div class="rounded-lg bg-dark-surface border border-dark-border px-4 py-2 text-sm font-medium">
              {platform}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
