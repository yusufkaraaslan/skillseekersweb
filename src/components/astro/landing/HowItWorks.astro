---
// How It Works section with visual workflow
---

<section class="py-20 bg-dark-bg">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center mb-16">
      <h2 class="text-4xl font-bold mb-4">
        How It Works
      </h2>
      <p class="text-xl text-dark-text-secondary">
        Four simple steps to transform any documentation into an AI skill
      </p>
    </div>

    <!-- Workflow Steps -->
    <div class="max-w-5xl mx-auto">
      <div class="relative">
        <!-- Connecting Line -->
        <div class="hidden lg:block absolute top-1/2 left-0 right-0 h-0.5 bg-gradient-to-r from-brand-primary via-brand-secondary to-brand-primary opacity-30 -translate-y-1/2" style="top: 80px;"></div>

        <!-- Steps Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 relative">
          <!-- Step 1 -->
          <div class="group relative">
            <div class="text-center">
              <!-- Step Number -->
              <div class="relative inline-flex items-center justify-center w-16 h-16 mb-6 rounded-full bg-gradient-to-br from-brand-primary to-brand-secondary text-white text-2xl font-bold shadow-lg shadow-brand-primary/50 transition-all duration-300 group-hover:scale-110 group-hover:shadow-2xl group-hover:shadow-brand-primary/60">
                1
              </div>

              <!-- Icon -->
              <div class="text-6xl mb-4 transition-transform duration-300 group-hover:scale-110">
                🎯
              </div>

              <!-- Title -->
              <h3 class="text-xl font-bold mb-2">Choose Source</h3>

              <!-- Description -->
              <p class="text-sm text-dark-text-secondary">
                Point to documentation, GitHub repo, or PDF file
              </p>

              <!-- Example -->
              <div class="mt-4 p-3 bg-dark-surface rounded-lg border border-dark-border">
                <code class="text-xs font-mono text-brand-primary">
                  docs.python.org
                </code>
              </div>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="group relative">
            <div class="text-center">
              <!-- Step Number -->
              <div class="relative inline-flex items-center justify-center w-16 h-16 mb-6 rounded-full bg-gradient-to-br from-brand-primary to-brand-secondary text-white text-2xl font-bold shadow-lg shadow-brand-primary/50 transition-all duration-300 group-hover:scale-110 group-hover:shadow-2xl group-hover:shadow-brand-primary/60">
                2
              </div>

              <!-- Icon -->
              <div class="text-6xl mb-4 transition-transform duration-300 group-hover:scale-110">
                🔍
              </div>

              <!-- Title -->
              <h3 class="text-xl font-bold mb-2">Extract Content</h3>

              <!-- Description -->
              <p class="text-sm text-dark-text-secondary">
                Scrape, parse, and structure all documentation
              </p>

              <!-- Example -->
              <div class="mt-4 p-3 bg-dark-surface rounded-lg border border-dark-border">
                <code class="text-xs font-mono text-brand-primary">
                  skill-seekers scrape
                </code>
              </div>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="group relative">
            <div class="text-center">
              <!-- Step Number -->
              <div class="relative inline-flex items-center justify-center w-16 h-16 mb-6 rounded-full bg-gradient-to-br from-brand-primary to-brand-secondary text-white text-2xl font-bold shadow-lg shadow-brand-primary/50 transition-all duration-300 group-hover:scale-110 group-hover:shadow-2xl group-hover:shadow-brand-primary/60">
                3
              </div>

              <!-- Icon -->
              <div class="text-6xl mb-4 transition-transform duration-300 group-hover:scale-110">
                ✨
              </div>

              <!-- Title -->
              <h3 class="text-xl font-bold mb-2">Enhance with AI</h3>

              <!-- Description -->
              <p class="text-sm text-dark-text-secondary">
                Add explanations, examples, and best practices
              </p>

              <!-- Example -->
              <div class="mt-4 p-3 bg-dark-surface rounded-lg border border-dark-border">
                <code class="text-xs font-mono text-brand-primary">
                  skill-seekers enhance
                </code>
              </div>
            </div>
          </div>

          <!-- Step 4 -->
          <div class="group relative">
            <div class="text-center">
              <!-- Step Number -->
              <div class="relative inline-flex items-center justify-center w-16 h-16 mb-6 rounded-full bg-gradient-to-br from-brand-primary to-brand-secondary text-white text-2xl font-bold shadow-lg shadow-brand-primary/50 transition-all duration-300 group-hover:scale-110 group-hover:shadow-2xl group-hover:shadow-brand-primary/60">
                4
              </div>

              <!-- Icon -->
              <div class="text-6xl mb-4 transition-transform duration-300 group-hover:scale-110">
                🚀
              </div>

              <!-- Title -->
              <h3 class="text-xl font-bold mb-2">Upload & Use</h3>

              <!-- Description -->
              <p class="text-sm text-dark-text-secondary">
                Deploy to Claude Projects or MCP
              </p>

              <!-- Example -->
              <div class="mt-4 p-3 bg-dark-surface rounded-lg border border-dark-border">
                <code class="text-xs font-mono text-brand-primary">
                  skill-seekers upload
                </code>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Time Estimate -->
      <div class="mt-16 text-center">
        <div class="inline-flex items-center space-x-3 px-8 py-4 bg-gradient-to-r from-brand-primary/10 to-brand-secondary/10 border border-brand-primary/30 rounded-xl">
          <svg class="h-8 w-8 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="text-left">
            <div class="text-sm text-dark-text-secondary">Total Time</div>
            <div class="text-2xl font-bold text-brand-primary">20-40 minutes</div>
          </div>
          <div class="text-3xl">⚡</div>
        </div>
      </div>

      <!-- Try It Now CTA -->
      <div class="mt-12 text-center">
        <a
          href="/docs/getting-started/quick-start"
          class="inline-flex items-center space-x-2 px-8 py-4 bg-gradient-to-r from-brand-primary to-brand-secondary text-white font-semibold rounded-lg shadow-lg shadow-brand-primary/50 transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-brand-primary/60"
        >
          <span>Try It Now</span>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
